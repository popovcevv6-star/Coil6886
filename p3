-- TP к деревьям
btnTpTree.MouseButton1Click:Connect(function()
	local char = lp.Character
	local hrp = char and char:FindFirstChild("HumanoidRootPart")
	if not hrp then return end
	local closestTree = nil
	local shortestDist = math.huge
	for _, obj in ipairs(Workspace:GetDescendants()) do
		local name = string.lower(obj.Name)
		if (string.find(name, "tree") or string.find(name, "birch") or string.find(name, "pine")) and not string.find(name, "big") and not string.find(name, "bench") then
			local part = obj:IsA("BasePart") and obj or obj:FindFirstChildWhichIsA("BasePart")
			if part then
				local dist = (hrp.Position - part.Position).Magnitude
				if dist < shortestDist then shortestDist = dist; closestTree = part end
			end
		end
	end
	if closestTree then hrp.CFrame = closestTree.CFrame * CFrame.new(2, 3, 2) end
end)

-- TP к костру
btnTpCamp.MouseButton1Click:Connect(function()
	local char = lp.Character
	local hrp = char and char:FindFirstChild("HumanoidRootPart")
	if not hrp then return end
	for _, obj in ipairs(Workspace:GetDescendants()) do
		if string.find(string.lower(obj.Name), "fire") or string.find(string.lower(obj.Name), "camp") then
			local part = obj:FindFirstChildWhichIsA("BasePart")
			if part then hrp.CFrame = part.CFrame + Vector3.new(0, 3, 0); break end
		end
	end
end)

-- TP и фарм кролика (липкий, тапает по экрану)
local isFarming = false
btnTpRabbit.MouseButton1Click:Connect(function()
	isFarming = not isFarming
	if not isFarming then return end
	
	task.spawn(function()
		while isFarming do
			local targetRabbit = nil
			local shortestDist = math.huge
			for _, obj in ipairs(Workspace:GetDescendants()) do
				if obj:IsA("Model") and (string.find(string.lower(obj.Name), "rabbit") or string.find(string.lower(obj.Name), "bunny")) then
					local hum = obj:FindFirstChildOfClass("Humanoid")
					local part = obj:FindFirstChild("HumanoidRootPart") or obj:FindFirstChildWhichIsA("BasePart")
					if part and (not hum or hum.Health > 0) then
						local dist = (lp.Character.HumanoidRootPart.Position - part.Position).Magnitude
						if dist < shortestDist then shortestDist = dist; targetRabbit = obj end
					end
				end
			end

			if targetRabbit then
				local hrp = lp.Character.HumanoidRootPart
				local rabbitPart = targetRabbit:FindFirstChild("HumanoidRootPart") or targetRabbit:FindFirstChildWhichIsA("BasePart")
				
				-- Цепляемся к кролику
				hrp.CFrame = rabbitPart.CFrame + Vector3.new(0, 2, 0)
				
				-- Эмулируем тап по центру экрана
				VIM:SendMouseButtonEvent(500, 500, 0, true, game, false)
				task.wait(0.05)
				VIM:SendMouseButtonEvent(500, 500, 0, false, game, false)
				
				task.wait(0.7) -- Задержка удара
			else
				isFarming = false
			end
		end
	end)
end)

