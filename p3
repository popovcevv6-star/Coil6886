-- Телепорт к деревьям
btnTpTree.MouseButton1Click:Connect(function()
	local char = lp.Character
	local hrp = char and char:FindFirstChild("HumanoidRootPart")
	if not hrp then return end

	local closestTree = nil
	local shortestDist = math.huge

	for _, obj in ipairs(Workspace:GetDescendants()) do
		local name = string.lower(obj.Name)
		local isExcluded = string.find(name, "bench") or string.find(name, "table") or string.find(name, "craft") 
			or string.find(name, "big") or string.find(name, "giant") or string.find(name, "large") 
			or string.find(name, "build") or string.find(name, "storage")

		local isSmallTree = (string.find(name, "tree") or string.find(name, "smalltree") or string.find(name, "birch") or string.find(name, "pine")) and not isExcluded

		if isSmallTree then
			local part = obj:IsA("BasePart") and obj or obj:FindFirstChildWhichIsA("BasePart")
			if part then
				local dist = (hrp.Position - part.Position).Magnitude
				if dist < shortestDist then
					shortestDist = dist
					closestTree = part
				end
			end
		end
	end

	if closestTree then
		hrp.CFrame = closestTree.CFrame * CFrame.new(2, 3, 2)
	end
end)

-- Телепорт к зайцам
btnTpRabbit.MouseButton1Click:Connect(function()
	local char = lp.Character
	local hrp = char and char:FindFirstChild("HumanoidRootPart")
	local hum = char and char:FindFirstChildOfClass("Humanoid")
	if not hrp or not hum then return end

	local closestRabbit = nil
	local shortestDist = math.huge

	for _, obj in ipairs(Workspace:GetDescendants()) do
		if obj:IsA("Model") then
			local name = string.lower(obj.Name)
			local isRabbitName = string.find(name, "rabbit") or string.find(name, "bunny") or string.find(name, "hare") or string.find(name, "заяц")
			local isBush = string.find(name, "bush") or string.find(name, "shrub") or string.find(name, "plant") or string.find(name, "spawner")

			if isRabbitName and not isBush then
				local rabbitHum = obj:FindFirstChildOfClass("Humanoid")
				local targetPart = obj.PrimaryPart or obj:FindFirstChild("HumanoidRootPart") or obj:FindFirstChild("Torso") or obj:FindFirstChild("Head") or obj:FindFirstChildWhichIsA("BasePart")

				if targetPart and (not rabbitHum or rabbitHum.Health > 0) then
					if not obj:FindFirstChild("Leaves") and not obj:FindFirstChild("Bush") then
						local dist = (hrp.Position - targetPart.Position).Magnitude
						if dist < shortestDist then
							shortestDist = dist
							closestRabbit = targetPart
						end
					end
				end
			end
		end
	end

	if closestRabbit then
		hum:ChangeState(Enum.HumanoidStateType.GettingUp)
		hrp.CFrame = CFrame.new(closestRabbit.Position + Vector3.new(0, 3, 0))
		hrp.AssemblyLinearVelocity = Vector3.zero
	end
end)

-- Speedhack x2.5
local speedActive = false
local normalSpeed = 16
local targetSpeed = 40

btnSpeed.MouseButton1Click:Connect(function()
	speedActive = not speedActive
	if speedActive then
		btnSpeed.BackgroundTransparency = 0.1
		btnSpeed.BackgroundColor3 = Color3.fromRGB(25, 25, 25)
	else
		btnSpeed.BackgroundTransparency = 0.5
		btnSpeed.BackgroundColor3 = Color3.fromRGB(60, 60, 60)
	end
end)

RunService.Heartbeat:Connect(function()
	local char = lp.Character
	local hum = char and char:FindFirstChildOfClass("Humanoid")
	if hum then
		if speedActive then
			hum.WalkSpeed = targetSpeed
		else
			if hum.WalkSpeed == targetSpeed then
				hum.WalkSpeed = normalSpeed
			end
		end
	end
end)

-- Fast Attack (Быстрая атака без задержки)
local fastAttackActive = false

btnFastAttack.MouseButton1Click:Connect(function()
	fastAttackActive = not fastAttackActive
	if fastAttackActive then
		btnFastAttack.BackgroundTransparency = 0.1
		btnFastAttack.BackgroundColor3 = Color3.fromRGB(25, 25, 25)
	else
		btnFastAttack.BackgroundTransparency = 0.5
		btnFastAttack.BackgroundColor3 = Color3.fromRGB(60, 60, 60)
	end
end)

RunService.RenderStepped:Connect(function()
	if fastAttackActive then
		local char = lp.Character
		if char then
			local tool = char:FindFirstChildOfClass("Tool")
			if tool then
				-- Активируем топор/оружие напрямую в обход анимаций
				tool:Activate()
				
				-- Поиск RemoteEvent удара внутри топора для авто-кликера
				for _, v in ipairs(tool:GetDescendants()) do
					if v:IsA("RemoteEvent") then
						v:FireServer()
					end
				end
			end
		end
	end
end)
