-- Поиск и телепорт к ближайшему объекту
local function tpToNearest(searchNames)
	local char = lp.Character
	local hrp = char and char:FindFirstChild("HumanoidRootPart")
	if not hrp then return end

	local closestObj = nil
	local shortestDist = math.huge

	for _, obj in ipairs(Workspace:GetDescendants()) do
		local matches = false
		for _, name in ipairs(searchNames) do
			if string.find(string.lower(obj.Name), string.lower(name)) then
				matches = true
				break
			end
		end

		if matches then
			local targetPart = obj:IsA("BasePart") and obj or obj:FindFirstChildWhichIsA("BasePart")
			if targetPart then
				local dist = (hrp.Position - targetPart.Position).Magnitude
				if dist < shortestDist then
					shortestDist = dist
					closestObj = targetPart
				end
			end
		end
	end

	if closestObj then
		hrp.CFrame = closestObj.CFrame * CFrame.new(0, 2, -3)
	end
end

-- Логика tp D. (Разовое нажатие)
btnTpTree.MouseButton1Click:Connect(function()
	tpToNearest({"tree", "древо", "дерево", "wood"})
end)

-- Логика tp Z. (Разовое нажатие)
btnTpRabbit.MouseButton1Click:Connect(function()
	tpToNearest({"rabbit", "hare", "заяц", "кролик", "bunny"})
end)

-- Логика speedhack (Вкл/Выкл с изменением прозрачности)
local speedActive = false
local normalSpeed = 16
local targetSpeed = 40 -- Скорость х2.5 (16 * 2.5 = 40)

btnSpeed.MouseButton1Click:Connect(function()
	speedActive = not speedActive
	if speedActive then
		btnSpeed.BackgroundTransparency = 0.1
		btnSpeed.BackgroundColor3 = Color3.fromRGB(25, 25, 25)
	else
		btnSpeed.BackgroundTransparency = 0.5
		btnSpeed.BackgroundColor3 = Color3.fromRGB(60, 60, 60)
	end
end)

RunService.Heartbeat:Connect(function()
	local char = lp.Character
	local hum = char and char:FindFirstChildOfClass("Humanoid")
	if hum then
		if speedActive then
			hum.WalkSpeed = targetSpeed
		else
			if hum.WalkSpeed == targetSpeed then
				hum.WalkSpeed = normalSpeed
			end
		end
	end
end)
