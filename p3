-- Ninja Legends Universal Script
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Players = game:GetService("Players")
local lp = Players.LocalPlayer

-- Универсальный поиск событий
local Events = ReplicatedStorage:FindFirstChild("rEvents") or ReplicatedStorage:FindFirstChild("Events")
local remotes = {}

if Events then
    for _, v in pairs(Events:GetChildren()) do
        if v:IsA("RemoteEvent") then remotes[string.lower(v.Name)] = v end
    end
end

-- Основные функции
local function swing()
    if remotes["swingtool"] then remotes["swingtool"]:FireServer()
    elseif remotes["swing"] then remotes["swing"]:FireServer() end
end

local function buy(item) -- item = "sword" или "belt"
    if remotes["buysword"] and item == "sword" then remotes["buysword"]:FireServer()
    elseif remotes["buybelt"] and item == "belt" then remotes["buybelt"]:FireServer() end
end

-- Авто-фарм (цикл)
task.spawn(function()
    while true do
        swing()
        buy("sword")
        buy("belt")
        task.wait(0.2)
    end
end)

-- ТП на последний остров
local function tpToTop()
    local islands = workspace:FindFirstChild("islands") or workspace
    local best = nil
    for _, v in pairs(islands:GetChildren()) do
        if v:FindFirstChild("teleportpart") then
            if not best or v:GetPivot().Position.Y > best:GetPivot().Position.Y then
                best = v
            end
        end
    end
    if best then lp.Character:MoveTo(best:GetPivot().Position) end
end

-- UI для телефона (сделаем максимально простым, чтобы не крашило)
local ScreenGui = Instance.new("ScreenGui", lp.PlayerGui)
local btn = Instance.new("TextButton", ScreenGui)
btn.Size = UDim2.new(0, 100, 0, 50)
btn.Position = UDim2.new(0.5, 0, 0.5, 0)
btn.Text = "TP Top"
btn.MouseButton1Click:Connect(tpToTop)
