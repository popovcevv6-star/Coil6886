local shakerActive = false

btnShaker.MouseButton1Click:Connect(function()
	shakerActive = not shakerActive
	btnShaker.Text = "camera shaker [" .. (shakerActive and "ON" or "OFF") .. "]"
end)

RunService.RenderStepped:Connect(function()
	if shakerActive then
		local myChar = lp.Character
		local myHrp = myChar and myChar:FindFirstChild("HumanoidRootPart")
		if myHrp then
			for _, p in ipairs(Players:GetPlayers()) do
				if p ~= lp and p.Character and p.Character:FindFirstChild("HumanoidRootPart") then
					local tHrp = p.Character.HumanoidRootPart
					if (myHrp.Position - tHrp.Position).Magnitude <= 20 then
						tHrp.CFrame = tHrp.CFrame * CFrame.Angles(
							math.rad(math.random(-15, 15)),
							math.rad(math.random(-15, 15)),
							math.rad(math.random(-15, 15))
						)
					end
				end
			end
		end
	end
end)

local hiddenfling = false
local flingThread

if not ReplicatedStorage:FindFirstChild("AntiFlingDetection") then
	local detection = Instance.new("Decal")
	detection.Name = "AntiFlingDetection"
	detection.Parent = ReplicatedStorage
end

local function fling()
	local c, hrp, vel, movel = nil, nil, nil, 0.1

	while hiddenfling do
		RunService.Heartbeat:Wait()
		c = lp.Character
		hrp = c and c:FindFirstChild("HumanoidRootPart")

		if hrp then
			vel = hrp.Velocity
			hrp.Velocity = vel * 10000 + Vector3.new(0, 10000, 0)
			RunService.RenderStepped:Wait()
			hrp.Velocity = vel
			RunService.Stepped:Wait()
			hrp.Velocity = vel + Vector3.new(0, movel, 0)
			movel = -movel
		end
	end
end

btnFling.MouseButton1Click:Connect(function()
	hiddenfling = not hiddenfling
	btnFling.Text = "fling [" .. (hiddenfling and "ON" or "OFF") .. "]"

	if hiddenfling then
		flingThread = coroutine.create(fling)
		coroutine.resume(flingThread)
	else
		hiddenfling = false
	end
end)

local espActive = false

local function getMM2Color(plr)
	local char = plr.Character
	if not char then return Color3.fromRGB(255, 255, 255) end

	if char:FindFirstChild("Knife") or plr.Backpack:FindFirstChild("Knife") then
		return Color3.fromRGB(255, 0, 0)
	elseif char:FindFirstChild("Revolver") or plr.Backpack:FindFirstChild("Revolver") or char:FindFirstChild("Gun") or plr.Backpack:FindFirstChild("Gun") then
		return Color3.fromRGB(0, 100, 255)
	end

	return Color3.fromRGB(255, 255, 255)
end

local function updateESP()
	for _, plr in ipairs(Players:GetPlayers()) do
		if plr ~= lp and plr.Character then
			local char = plr.Character
			local hl = char:FindFirstChild("ESPHighlight")

			if espActive then
				if not hl then
					hl = Instance.new("Highlight")
					hl.Name = "ESPHighlight"
					hl.FillTransparency = 1
					hl.OutlineTransparency = 0
					hl.Adornee = char
					hl.Parent = char
				end
				hl.OutlineColor = getMM2Color(plr)
			else
				if hl then
					hl:Destroy()
				end
			end
		end
	end
end

RunService.RenderStepped:Connect(updateESP)

btnEsp.MouseButton1Click:Connect(function()
	espActive = not espActive
	btnEsp.Text = "esp [" .. (espActive and "ON" or "OFF") .. "]"
	if not espActive then
		for _, plr in ipairs(Players:GetPlayers()) do
			if plr.Character and plr.Character:FindFirstChild("ESPHighlight") then
				plr.Character.ESPHighlight:Destroy()
			end
		end
	end
end)

local spinActive = false
local spinAngle = 0

btnSpin.MouseButton1Click:Connect(function()
	spinActive = not spinActive
	btnSpin.Text = "spinbot 360 [" .. (spinActive and "ON" or "OFF") .. "]"
end)

RunService.Heartbeat:Connect(function()
	if spinActive then
		local char = lp.Character
		local hrp = char and char:FindFirstChild("HumanoidRootPart")
		if hrp then
			spinAngle = spinAngle + 150
			hrp.CFrame = CFrame.new(hrp.Position) * CFrame.Angles(0, math.rad(spinAngle), 0)
			hrp.AssemblyAngularVelocity = Vector3.new(0, 500, 0)
		end
	end
end)

local speedActive = false

btnSpeed.MouseButton1Click:Connect(function()
	speedActive = not speedActive
	btnSpeed.Text = "speed x2 [" .. (speedActive and "ON" or "OFF") .. "]"
end)

RunService.Heartbeat:Connect(function()
	local char = lp.Character
	local hum = char and char:FindFirstChild("Humanoid")
	if hum then
		if speedActive then
			hum.WalkSpeed = 32
		else
			if hum.WalkSpeed == 32 then
				hum.WalkSpeed = 16
			end
		end
	end
end)
