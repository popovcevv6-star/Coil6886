local Players = game:GetService("Players")
local VIM = game:GetService("VirtualInputManager")
local lp = Players.LocalPlayer

-- UI (Минималистичный)
local ScreenGui = Instance.new("ScreenGui", lp:WaitForChild("PlayerGui"))
local MainFrame = Instance.new("Frame", ScreenGui)
MainFrame.Size = UDim2.new(0, 150, 0, 50)
MainFrame.Position = UDim2.new(0.5, -75, 0.2, 0)
MainFrame.BackgroundColor3 = Color3.fromRGB(0, 0, 0)
MainFrame.BackgroundTransparency = 0.5
MainFrame.Active = true
MainFrame.Draggable = true
Instance.new("UICorner", MainFrame)

local Btn = Instance.new("TextButton", MainFrame)
Btn.Size = UDim2.new(1, 0, 1, 0)
Btn.Text = "OFF"
Btn.TextColor3 = Color3.new(1, 1, 1)
Btn.BackgroundTransparency = 1

local active = false

Btn.MouseButton1Click:Connect(function()
    active = not active
    Btn.Text = active and "ON" or "OFF"
    MainFrame.BackgroundColor3 = active and Color3.fromRGB(0, 100, 0) or Color3.fromRGB(0, 0, 0)
end)

-- Отдельный поток (чтобы не зависал)
task.spawn(function()
    while true do
        if active then
            local pos = Vector2.new(workspace.CurrentCamera.ViewportSize.X/2, workspace.CurrentCamera.ViewportSize.Y/2)
            
            -- Выполняем клик
            pcall(function()
                VIM:SendTouchEvent(pos.X, pos.Y, true, game)
                task.wait(0.05)
                VIM:SendTouchEvent(pos.X, pos.Y, false, game)
            end)
        end
        task.wait(0.2) -- Задержка
    end
end)
