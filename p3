local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local lp = Players.LocalPlayer

-- UI
local ScreenGui = Instance.new("ScreenGui", lp:WaitForChild("PlayerGui"))
local MainFrame = Instance.new("Frame", ScreenGui)
MainFrame.Size = UDim2.new(0, 160, 0, 50)
MainFrame.Position = UDim2.new(0.5, -80, 0.4, 0)
MainFrame.BackgroundColor3 = Color3.fromRGB(30, 30, 30)
Instance.new("UICorner", MainFrame)
MainFrame.Active = true
MainFrame.Draggable = true

local ToggleBtn = Instance.new("TextButton", MainFrame)
ToggleBtn.Size = UDim2.new(0.9, 0, 0.8, 0)
ToggleBtn.Position = UDim2.new(0.05, 0, 0.1, 0)
ToggleBtn.BackgroundColor3 = Color3.fromRGB(60, 60, 60)
ToggleBtn.Text = "Auto Swing: OFF"
ToggleBtn.TextColor3 = Color3.new(1, 1, 1)
Instance.new("UICorner", ToggleBtn)

-- Логика поиска события
local SwingEvent = nil

-- Ищем событие в папках событий
local function findEvent()
    local folderNames = {"rEvents", "Events", "Remote"}
    for _, folderName in pairs(folderNames) do
        local folder = ReplicatedStorage:FindFirstChild(folderName)
        if folder then
            for _, v in pairs(folder:GetChildren()) do
                -- Ищем слова, связанные с ударом
                if v:IsA("RemoteEvent") and (v.Name:lower():find("swing") or v.Name:lower():find("click")) then
                    return v
                end
            end
        end
    end
    return nil
end

SwingEvent = findEvent()

-- Управление
local active = false
ToggleBtn.MouseButton1Click:Connect(function()
    active = not active
    ToggleBtn.Text = active and "Auto Swing: ON" or "Auto Swing: OFF"
    ToggleBtn.BackgroundColor3 = active and Color3.fromRGB(0, 150, 0) or Color3.fromRGB(60, 60, 60)
    
    -- Если не нашли событие при запуске, пробуем еще раз при включении
    if active and not SwingEvent then SwingEvent = findEvent() end
end)

-- Сам кликер (фигачит по серверу)
task.spawn(function()
    while true do
        if active and SwingEvent then
            SwingEvent:FireServer()
        end
        task.wait(0.1)
    end
end)
